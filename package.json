{
  "name": "SteamCodeStatus",
  "displayName": "SteamCodeStatus",
  "description": "Sync your VS Code activity to Steam Rich Presence.",
  "version": "1.0.5",
  "publisher": "tudou0133",
  "author": {
    "name": "tudou0133",
    "url": "https://github.com/tudou0133"
  },
  "contributors": [
    {
      "name": "furrylogy",
      "url": "https://github.com/furrylogy"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tudou0133/VSCode_SteamCodeStatus.git"
  },
  "bugs": {
    "url": "https://github.com/tudou0133/VSCode_SteamCodeStatus/issues"
  },
  "homepage": "https://github.com/tudou0133/VSCode_SteamCodeStatus/blob/main/README.md",
  "icon": "images/icon.png",
  "keywords": [
    "steam",
    "rich presence",
    "status",
    "game"
  ],
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeStatus.showMainMenu",
        "title": "CodeStatus: 打开设置菜单 (Main Menu)"
      },
      {
        "command": "codeStatus.toggleEnabled",
        "title": "CodeStatus: 切换启用/禁用 (Toggle Enable)"
      },
      {
        "command": "codeStatus.setGroupId",
        "title": "CodeStatus: 设置组队 ID (Set Group ID)"
      },
      {
        "command": "codeStatus.setManualStatus",
        "title": "CodeStatus: 手动修改状态 (Manual Override)"
      }
    ],
    "configuration": {
        "title": "SteamCodeStatus配置", 
        "properties": {
            "codeStatus.enabled": {
                "type": "boolean",
                "default": true,
                "description": "是否启用 Steam 状态同步插件"
            },
            "codeStatus.steamAppId": {
                "type": "string",
                "default": "730",
                "description": "目标游戏的 AppID (例如: 480 或 730)"
            },
            "codeStatus.displayTemplate": {
                "type": "string",
                "default": "#display_GameKnownMapScore",
                "description": "Rich Presence 模板 Key (例如: #Status 或 #display_GameKnownMapScore)"
            },
            "codeStatus.dynamicKey": {
                "type": "string",
                "default": "game:score",
                "description": "用于显示文件名的动态参数 Key (例如: status 或 game:score)"
            },
            "codeStatus.staticArgs": {
                "type": "string",
                "default": "game:mode=competitive & game:map=de_mirage",
                "description": "静态参数，格式 key1=value1 & key2=value2 (例如: game:mode=competitive)"
            },
            "codeStatus.statusTemplate": {
                "type": "string",
                "default": "正在编写 {folderName}/{fileName}",
                "description": "自定义状态栏显示格式。支持变量: {projectName}, {fileName}, {language}, {lineCount}, {filePath}, {folderName}。使用 [...] 包裹的内容仅在变量存在时显示。",
                "order": 1
            },
            "codeStatus.idleText": {
                "type": "string",
                "default": "正在摸鱼🐟",
                "description": "当没有打开文件时显示的文本",
                "order": 2
            },
            "codeStatus.groupId": {
                "type": "string",
                "default": "",
                "description": "Steam 组队ID "
            },
            "codeStatus.groupSize": {
                "type": "string",
                "default": "1",
                "description": "Steam 组队人数"
            }
        }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test",
    "copy:native_win": "node tools/copy-steam-native.js win-x64",
    "copy:native_linux": "node tools/copy-steam-native.js linux-x64",
    "build:bridge_x64": "dotnet publish bridge/SteamRichPresenceBridge.csproj -c Release -r win-x64 --self-contained true -o backend/win-x64 && npm run copy:native_win",
    "build:bridge_linux": "dotnet publish bridge/SteamRichPresenceBridge.csproj -c Release -r linux-x64 --self-contained true -o backend/linux-x64 && npm run copy:native_linux",
    "build:all": "npm run compile && npm run build:bridge_x64 && npm run build:bridge_linux"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
